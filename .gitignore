# Default-deny: explicitly admit only operational code and documentation.
*
!/.gitignore
!/AGENTS.md
!/Brewfile
!/LICENSE
!/Makefile
!/README.md
!/config.template.yaml
!/pyproject.toml
!/uv.lock
!/.pre-commit-config.yaml
!/.release-please.local.json
!/.release-please-manifest.json
!/cog.toml
!/release-please-config.json
!/renovate.json

!/.shared/
!/.shared/*

!/.github/
!/.github/.shared-config.yaml
!/.github/workflows/
!/.github/workflows/*.yaml

!/.githooks/
!/.githooks/*

!/scripts/
!/scripts/sync-shared
!/scripts/sync-shared-drift-check

!/tests/
!/tests/*.py

!/docs/
!/docs/_quarto.yml
!/docs/*.qmd

!/plans/
!/plans/*.md

!/src/
!/src/**/
!/src/**/*.py
!/src/**/*.md
.shared/
